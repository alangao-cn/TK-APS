# API 密钥与登录信息，复制为 .env 后填写，不要提交到代码仓库
# 脚本生成和视频生成共用这一个 Key
ZENMUX_API_KEY=

# 可选：本地访问 zenmux.ai 需要代理时填写，例如 http://127.0.0.1:7890
HTTPS_PROXY=

# 可选：FastMoss 自动登录（手机号+密码）。留空则登录过期时人工扫码/输密码
# 登录流程：右上角登录/注册 → 手机号tab → 小按钮“密码登录” → 密码表单
FASTMOSS_PHONE=
FASTMOSS_PASSWORD=

# 网页登录账号（局域网访问，也要设置）
WEB_USERNAME=admin
WEB_PASSWORD=
